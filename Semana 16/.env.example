# Solo para docker compose: copia a .env y usa valores aleatorios largos.
# Las credenciales entre servicios no van aqui: vault-init las genera en Vault.

# Token raiz de Vault (solo lo usa vault-init).
VAULT_ROOT_TOKEN=reemplazar

# Token de Vault de cada servicio: solo puede leer su propia ruta secret/<servicio>.
GATEWAY_VAULT_TOKEN=reemplazar
AUTH_VAULT_TOKEN=reemplazar
INVENTORY_VAULT_TOKEN=reemplazar
ORDERS_VAULT_TOKEN=reemplazar
CLIENTS_VAULT_TOKEN=reemplazar
PAYMENTS_VAULT_TOKEN=reemplazar
GRAPHQL_VAULT_TOKEN=reemplazar

# Clave del administrador de PostgreSQL (solo la usa vault-init para crear un rol por servicio).
POSTGRES_PASSWORD=reemplazar

# Claves del proveedor de pago (externo). payments las recibe por Vault.
PASARELA_API_KEY=reemplazar
PASARELA_WEBHOOK_SECRET=reemplazar
