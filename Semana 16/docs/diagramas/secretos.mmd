---
title: Secretos en Vault - una ruta y un token por servicio
---
flowchart LR
    ini[iniciar.py / vault-init<br>token raiz]
    rot[rotar.py<br>token raiz]

    subgraph vault[Vault :8200 - KV v2]
        sgw[secret/gateway]
        sau[secret/auth]
        sin[secret/inventory]
        sor[secret/orders]
        scl[secret/clients]
        spa[secret/payments]
        sgq[secret/graphql]
    end

    ini -- escribe secretos, politicas y tokens --> vault
    rot -- rota en dos fases --> vault

    gw[API Gateway] -- token propio, solo lectura --> sgw
    au[auth] --> sau
    inv[inventory] --> sin
    ord[orders] --> sor
    cli[clients] --> scl
    pay[payments] --> spa
    gq[GraphQL] --> sgq
    ord -. 403: no puede leer otra ruta .-x spa
