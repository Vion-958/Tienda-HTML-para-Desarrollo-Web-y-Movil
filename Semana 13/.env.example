# Copia este archivo como .env (no se sube a Git).
# Valores del laboratorio: cámbialos si quieres probar la rotación de secretos.

# Token raíz de Vault en modo dev. Solo para el laboratorio.
VAULT_TOKEN=dev-only-token

# Secreto Gateway -> Backend (header X-Gateway-Secret)
BACKEND_SHARED_SECRET=gateway-api-secret-456

# Secreto Gateway -> Auth Service (header X-Introspection-Secret)
AUTH_INTROSPECTION_SECRET=gateway-auth-secret-789

# Duración de la sesión en segundos
SESSION_TTL_SECONDS=900

# Usuario del broker ActiveMQ (Semana 13). Son los valores por defecto de
# productor.py y consumidor.py.
ACTIVEMQ_USER=demo
ACTIVEMQ_PASSWORD=demo123
