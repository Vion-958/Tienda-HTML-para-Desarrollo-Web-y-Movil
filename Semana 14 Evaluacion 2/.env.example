# Solo para docker compose. Con "python iniciar.py" no se usa: los secretos
# se generan al azar en cada arranque y nunca se escriben en disco.
# Copia este archivo a .env y reemplaza cada valor por uno aleatorio largo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VAULT_TOKEN=reemplazar
GATEWAY_AUTH=reemplazar
GATEWAY_INVENTORY=reemplazar
GATEWAY_ORDERS=reemplazar
GATEWAY_CLIENTS=reemplazar
GATEWAY_PAYMENTS=reemplazar
GATEWAY_GRAPHQL=reemplazar
ORDERS_INVENTORY=reemplazar
PAYMENTS_ORDERS=reemplazar
GRAPHQL_ORDERS=reemplazar
GRAPHQL_INVENTORY=reemplazar
GRAPHQL_PAYMENTS=reemplazar
GRAPHQL_CLIENTS=reemplazar
PASARELA_API_KEY=reemplazar
PASARELA_WEBHOOK_SECRET=reemplazar
